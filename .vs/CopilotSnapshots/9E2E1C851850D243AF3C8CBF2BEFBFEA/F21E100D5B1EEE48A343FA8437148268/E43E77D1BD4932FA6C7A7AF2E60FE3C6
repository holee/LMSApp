@page "/App/Account/Login"
@attribute [AllowAnonymous]
@layout Web.UI.Layout.EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Applications.Features.Identity.Users
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen.Blazor
@using Web.UI.Services.Authentications
@inject AuthenticationClient _authClient
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider

<PageTitle>Sign in</PageTitle>

<div class="login-shell">
    <div class="login-frame">
        <div class="login-visual">
            <div class="login-visual__glow"></div>
            <div class="login-visual__content">
                <div class="login-visual__logo">
                    <RadzenIcon Icon="account_balance" />
                </div>
                <h1 class="login-visual__title">សហគ្រាសបញ្ចាំទ្រព្យជុំ</h1>
                <p class="login-visual__sub">Loan Management System</p>
                <p class="login-visual__desc">
                    Manage loans, repayments and members in one secure, easy-to-use place.
                </p>
            </div>
        </div>

        <div class="login-panel">
            <div class="login-card">
                <div class="login-card__head">
                    <h2 class="login-card__title">Welcome back</h2>
                    <p class="login-card__sub">Sign in to continue to your account</p>
                </div>

                <EditForm Model="_model" OnValidSubmit="SignInAsync" FormName="login">
                    <DataAnnotationsValidator />

                    <div class="login-field">
                        <label for="login-email">Email</label>
                        <div class="login-input-group">
                            <span class="login-input-group__icon"><RadzenIcon Icon="mail" /></span>
                            <InputText id="login-email" class="login-input" @bind-Value="_model.Email"
                                       autocomplete="username" placeholder="you@example.com" />
                        </div>
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="login-field">
                        <label for="login-password">Password</label>
                        <div class="login-input-group">
                            <span class="login-input-group__icon"><RadzenIcon Icon="lock" /></span>
                            <InputText id="login-password" type="@(_showPassword ? "text" : "password")" class="login-input"
                                       @bind-Value="_model.Password"
                                       autocomplete="current-password" placeholder="••••••••" />
                            <button type="button" class="login-input-group__toggle" tabindex="-1"
                                    @onclick="() => _showPassword = !_showPassword"
                                    aria-label="Toggle password visibility">
                                <RadzenIcon Icon="@(_showPassword ? "visibility_off" : "visibility")" />
                            </button>
                        </div>
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>

                    <div class="login-row">
                        <label class="login-remember">
                            <InputCheckbox @bind-Value="_model.RememberMe" />
                            <span>Remember me</span>
                        </label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="login-error" role="alert">
                            <RadzenIcon Icon="error_outline" />
                            <span>@_error</span>
                        </div>
                    }

                    <button type="submit" class="login-submit" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="login-submit__spinner"></span>
                            <span>Signing in…</span>
                        }
                        else
                        {
                            <span>Sign in</span>
                        }
                    </button>
                </EditForm>

                <div class="login-card__foot">&copy; @DateTime.Now.Year LoanMS</div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;
    private bool _showPassword;

    protected override async Task OnInitializedAsync()
    {
        var state = await _authStateProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo(Destination(), replace: true);
        }
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;

        var request = new LoginRequest
        {
            Email = _model.Email,
            Password = _model.Password,
            RememberMe = _model.RememberMe
        };

        var (success, message) = await _authClient.LoginAsync(request);

        _busy = false;

        if (!success)
        {
            _error = string.IsNullOrWhiteSpace(message) ? "Invalid credentials." : message;
            return;
        }

        NavigationManager.NavigateTo(Destination(), replace: true);
    }

    private string Destination()
        => string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : $"/{ReturnUrl.TrimStart('/')}";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
