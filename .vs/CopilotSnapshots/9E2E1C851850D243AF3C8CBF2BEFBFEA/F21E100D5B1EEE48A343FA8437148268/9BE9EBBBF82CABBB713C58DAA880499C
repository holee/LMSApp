.login-shell {
  --login-primary: var(--rz-success, #16794f);
  --login-primary-dark: #0f5a39;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  background: #eef2f1;
}

.login-frame {
  width: 100%;
  max-width: 920px;
  min-height: 560px;
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
  overflow: hidden;
}

/* ---------- Visual / brand panel ---------- */

.login-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem 2.5rem;
  background: linear-gradient(155deg, var(--login-primary) 0%, var(--login-primary-dark) 100%);
  color: #fff;
  overflow: hidden;
}

.login-visual__glow {
  position: absolute;
  inset: -40% -20% auto auto;
  width: 420px;
  height: 420px;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

.login-visual__content {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 320px;
}

.login-visual__logo {
  width: 64px;
  height: 64px;
  margin: 0 auto 1.25rem;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-visual__logo .rz-icon,
.login-visual__logo ::deep .rzi {
  font-size: 2rem;
  color: #fff;
}

.login-visual__title {
  font-size: 1.3rem;
  font-weight: 700;
  margin: 0 0 0.35rem;
  line-height: 1.4;
}

.login-visual__sub {
  margin: 0 0 1rem;
  font-size: 0.95rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}

.login-visual__desc {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.75);
}

/* ---------- Form panel ---------- */

.login-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem 2.5rem;
}

.login-card {
  width: 100%;
  max-width: 340px;
}

.login-card__head {
  margin-bottom: 1.75rem;
}

.login-card__title {
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0 0 0.35rem;
  color: #111827;
}

.login-card__sub {
  margin: 0;
  font-size: 0.85rem;
  color: #6b7280;
}

.login-field {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  margin-bottom: 1.1rem;
}

.login-field label {
  font-size: 0.8rem;
  font-weight: 600;
  color: #374151;
}

.login-input-group {
  position: relative;
  display: flex;
  align-items: center;
}

.login-input-group__icon {
  position: absolute;
  left: 0.75rem;
  font-size: 1.15rem;
  color: #9ca3af;
  pointer-events: none;
}

.login-input {
  width: 100%;
  padding: 0.65rem 0.75rem 0.65rem 2.5rem;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  font-size: 0.9rem;
  background: #f9fafb;
  transition:
    border-color 0.15s ease,
    box-shadow 0.15s ease,
    background 0.15s ease;
}

.login-input-group__toggle {
  position: absolute;
  right: 0.4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: none;
  background: transparent;
  color: #9ca3af;
  border-radius: 6px;
  cursor: pointer;
  transition: color 0.15s ease, background 0.15s ease;
}

.login-input-group__toggle:hover {
  color: #374151;
  background: #e5e7eb;
}

.login-input-group:has(.login-input-group__toggle) .login-input {
  padding-right: 2.5rem;
}

.login-input:focus {
  outline: none;
  border-color: var(--login-primary);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(22, 121, 79, 0.15);
}

.login-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.login-remember {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 0.82rem;
  color: #374151;
  cursor: pointer;
}

.login-error {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #b91c1c;
  border-radius: 8px;
  padding: 0.55rem 0.7rem;
  font-size: 0.82rem;
  margin-bottom: 1rem;
}

.login-error .rz-icon,
.login-error ::deep .rzi {
  font-size: 1rem;
}

.login-submit {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--login-primary) 0%, var(--login-primary-dark) 100%);
  color: #fff;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(22, 121, 79, 0.25);
  transition: filter 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
}

.login-submit:hover:not(:disabled) {
  filter: brightness(1.06);
  transform: translateY(-1px);
  box-shadow: 0 10px 24px rgba(22, 121, 79, 0.32);
}

.login-submit:active:not(:disabled) {
  transform: translateY(0);
}

.login-submit:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.login-submit__spinner {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: #fff;
  animation: login-spin 0.7s linear infinite;
}

@keyframes login-spin {
  to {
    transform: rotate(360deg);
  }
}

.login-card__foot {
  margin-top: 1.5rem;
  text-align: center;
  font-size: 0.75rem;
  color: #9ca3af;
}

.login-card ::deep .validation-message {
  display: block;
  font-size: 0.75rem;
  color: #b91c1c;
  margin-top: 0.15rem;
}

@media (max-width: 820px) {
  .login-frame {
    grid-template-columns: 1fr;
    max-width: 420px;
    min-height: unset;
  }

  .login-visual {
    display: none;
  }

  .login-panel {
    padding: 2.5rem 1.75rem;
  }
}
